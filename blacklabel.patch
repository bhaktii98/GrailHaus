+
+  ["MORE", "THAN", "CARDS"].forEach((l, i) => drawTrackedText(canvas, l, 30 * s, (232 + i * 20) * s, {
+    size: 11 * s, bold: true, mono: true, letterSpacing: 3 * s, fill: "rgba(201,162,74,0.46)", align: "left",
