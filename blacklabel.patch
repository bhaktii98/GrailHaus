+    size: 17 * s, bold: true, mono: true, letterSpacing: 8 * s, shader: bronzeShader(H - 138 * s, H - 110 * s),
+  });
+
+  crimpBand(canvas, W, 0, flap, true, s);
+  crimpBand(canvas, W, H - flap, H, false, s);
+  tearChannel(canvas, W, seam, s);
+  canvas.restore();
+  return { data: surf.toRGBA(), width: W, height: H };
+}
+
+export function drawBack(input: VaultFaceInput): PixelImage {
+  const { width: W, height: H, seamFrac, flapFrac } = input;
+  const s = W / DESIGN_W;
+  const surf = makeSurface(W, H);
+  const { canvas } = surf;
+
+  canvas.save();
+  canvas.clipPath(silhouettePath(W, H, 34 * s), ClipOp.Intersect, true);
+  satinBase(canvas, W, H, s);
+  const flap = H * flapFrac, seam = H * seamFrac;
+
+  guilloche(canvas, W / 2, H * 0.44, { r: 250 * s, lobes: 13, lines: 26, ripple: 0.14, stroke: "rgba(201,162,74,0.09)" });
+  guilloche(canvas, W / 2, H * 0.44, { r: 132 * s, lobes: 7, lines: 16, turns: 3, ripple: 0.2, stroke: "rgba(201,162,74,0.1)" });
+
+  drawTrackedText(canvas, "GRAILHAUS · SERIES I", W / 2, 132 * s, {
+    size: 22 * s, bold: true, mono: true, letterSpacing: 9 * s, shader: bronzeShader(112 * s, 138 * s),
+  });
+  drawTrackedText(canvas, "CERTIFIED COLLECTOR PACKAGING", W / 2, 164 * s, {
+    size: 12 * s, bold: true, mono: true, letterSpacing: 5 * s, fill: "rgba(244,236,224,0.44)",
+  });
+
+  const ax = 56 * s, ay = seam + 40 * s, aw = W - 112 * s, ah = H - seam - flap - 96 * s;
+  canvas.drawPath(roundRectPath(ax, ay, aw, ah, 10 * s), strokePaint("rgba(0,0,0,0.6)", 5 * s));
+  canvas.drawPath(roundRectPath(ax, ay, aw, ah, 10 * s), strokePaint("rgba(201,162,74,0.3)", 1.4 * s));
+  canvas.drawPath(roundRectPath(ax + 10 * s, ay + 10 * s, aw - 20 * s, ah - 20 * s, 6 * s), strokePaint("rgba(201,162,74,0.14)", 1 * s));
+
+  const gridPaint = strokePaint("rgba(201,162,74,0.04)", 1 * s);
+  for (let i = 1; i < 6; i++) {
+    const y = ay + (ah * i) / 6;
+    const gp = Skia.Path.Make();
+    gp.moveTo(ax + 18 * s, y); gp.lineTo(ax + aw - 18 * s, y);
+    canvas.drawPath(gp, gridPaint);
+  }
+
+  editionPlate(canvas, W / 2, ay + 108 * s, 420 * s, 74 * s, "BLACK LABEL");
+  drawTrackedText(canvas, "TIER III · HIGH-STAKES", W / 2, ay + 170 * s, {
+    size: 13 * s, bold: true, mono: true, letterSpacing: 6 * s, fill: "rgba(201,162,74,0.52)",
+  });
+
+  const cy0 = ay + 226 * s;
+  const rows: [string, string][] = [
+    ["CONTENTS", "7 COLLECTOR CARDS"],
+    ["GUARANTEE", "2 PRIME OR ABOVE"],
+    ["SEALED", "AT SOURCE · GH ATELIER"],
+    ["AUTH", "BL-S1C-00250"],
+  ];
+  rows.forEach(([k, v], i) => {
+    const y = cy0 + i * 40 * s;
