+  const badgeStroke = Skia.Paint();
+  badgeStroke.setStyle(PaintStyle.Stroke); badgeStroke.setAntiAlias(true); badgeStroke.setStrokeWidth(2 * s);
+  badgeStroke.setShader(bronzeShader(by, by + bh));
