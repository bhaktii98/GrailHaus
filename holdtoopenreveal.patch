+        if (c > 0.6) rate *= 1 - 0.62 * res; // rare cards resist
+        if (res > 0.5 && c > 0.78 && c < 0.87) rate *= 0.2; // the stall
+        const nextCharge = Math.min(1, c + dt * rate);
+        chargeSV.value = nextCharge;
+        liftSV.value = liftSV.value + (1 - liftSV.value) * Math.min(1, dt * 7);
+        resSV.value = resSV.value + (res * (0.35 + 0.65 * nextCharge) - resSV.value) * Math.min(1, dt * 4.5);
+        jitterSV.value = Math.sin(now / (66 - res * 42)) * res * (0.05 + 0.05 * nextCharge) * nextCharge;
+
+        if (nextCharge >= 1) {
+          const opened = hi;
+          heldRef.current = null;
+          chargeSV.value = 0;
+          resSV.value = 0;
+          liftSV.value = 1;
+          setStatus((prev) => prev.map((s, idx) => (idx === opened ? "open" : s === "open" ? "sealed" : s)));
+          setOpenIndex(opened);
+          setHeldIndex(null);
+          const rarity = rarities[opened];
+          const feedback =
+            rarity === "GRAIL"
+              ? Haptics.NotificationFeedbackType.Success
+              : rarity === "PRIME"
+                ? Haptics.NotificationFeedbackType.Warning
+                : Haptics.NotificationFeedbackType.Success;
+          Haptics.notificationAsync(feedback);
+        }
+      } else {
+        chargeSV.value = Math.max(0, chargeSV.value - dt * 2.6);
+        resSV.value = Math.max(0, resSV.value - dt * 1.8);
+        jitterSV.value = jitterSV.value * Math.pow(0.02, dt);
+      }
+
+      rafRef.current = requestAnimationFrame(loop);
+    },
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [holdMs, tuning, rarities]
+  );
+
+  useEffect(() => {
+    prevTimeRef.current = 0;
+    rafRef.current = requestAnimationFrame(loop);
+    return () => {
+      if (rafRef.current != null) cancelAnimationFrame(rafRef.current);
+    };
+  }, [loop]);
+
+  const grab = useCallback(
+    (i: number) => {
+      if (openIndex != null || heldRef.current != null) return;
+      if (statusRef.current[i] !== "sealed" || topSealedIndex() !== i) return;
+      heldRef.current = i;
+      chargeSV.value = 0;
+      setHeldIndex(i);
+      Haptics.selectionAsync();
+    },
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [openIndex, topSealedIndex]
+  );
+
+  const release = useCallback(() => {
+    heldRef.current = null;
+    setHeldIndex(null);
+  }, []);
+
+  const dock = useCallback(() => {
+    if (openIndex == null) return;
+    liftSV.value = 0;
+    setStatus((prev) => prev.map((s) => (s === "open" ? "pulled" : s)));
+    setOpenIndex(null);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [openIndex]);
+
+  const revealAll = useCallback(() => {
+    heldRef.current = null;
+    chargeSV.value = 0;
+    liftSV.value = 0;
+    setHeldIndex(null);
+    setOpenIndex(null);
+    setStatus(rarities.map(() => "pulled"));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [rarities]);
+
+  const activeIndex = heldIndex ?? openIndex;
+  const activeTuning = activeIndex != null ? tuning[activeIndex] : null;
+  const revealedCount = status.filter((s) => s !== "sealed").length;
+  const done = revealedCount === total && openIndex == null && heldIndex == null;
+
+  return {
+    status, heldIndex, openIndex, isGrabbable,
+    chargeSV, liftSV, jitterSV, resSV,
+    activeTuning, revealedCount, total, done,
+    grab, release, dock, revealAll,
+  };
+}
