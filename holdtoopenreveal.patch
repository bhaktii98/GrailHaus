+
+      <DescriptionPanel
+        item={selectedIndex !== null ? items[selectedIndex] : null}
+        card={selectedIndex !== null ? deck[selectedIndex] : null}
+        tierColorHex={tierColorHex}
+        visible={selectedIndex !== null}
+        onClose={() => setSelectedIndex(null)}
+      />
+    </View>
+  );
+}
