+              TOTAL VALUE <Text style={styles.totalValue}>${(totalValueCents / 100).toFixed(0)}</Text>
+            </Text>
+            <Pressable
+              style={[styles.continueButton, { borderColor: `rgba(${palette.accentRGB},0.5)`, backgroundColor: `rgba(${palette.accentRGB},0.1)` }]}
