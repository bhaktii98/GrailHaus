+// The press-and-hold, strictly-one-card-at-a-time reveal mechanic — shared by all three card
+// tiers' post-tear reveal screens (vaultReveal/VaultCardFanReveal.tsx,
+// blackLabelReveal/BlackLabelFanReveal.tsx, reveal/CardPackFanReveal.tsx). Replaces each tier's
+// previous automatic, timer-staggered "card N flips on its own cue" reveal with a deliberate
+// per-card gesture: hold the top sealed card until it charges open, tap it again to set it down,
+// then the next card becomes holdable.
+//
+// This is a direct, hardened port of a Claude Design canvas (GrailHaus_Fan_Rip.dc_3.html)'s own
+// tick()/grab()/dock() state machine — same charge/resonance/lift physics, same per-rarity
+// resist-and-stall feel. That canvas had a real bug: which card counted as "open" was tracked in
+// two places that were supposed to always agree (an instance field and a per-card status flag),
+// and its `grab()` only guarded on a `phase` flag set through a possibly-lagging state update —
+// so a second hold could start before the first card's "open" status had actually landed, and two
+// cards could end up flagged open at once. Ported here with that fixed structurally instead of
+// reproduced: `status` is the *only* source of truth for which card is open — nothing else tracks
+// it in parallel — and `grab` is only ever driven by React state read fresh on every call (no
+// separate instance field that can lag behind it), so the failure mode the fix targeted has no
+// analog in this version.
+//
+// The continuous per-frame physics (charge fill, resonance ramp, lift, jitter) live in Reanimated
+// shared values, written from a plain requestAnimationFrame loop on the JS thread — cheap enough
+// at this scale (a handful of scalars) not to need UI-thread worklets, and it keeps this hook
+// framework-simple. React state (`status`/`heldIndex`/`openIndex`) only changes at the meaningful
+// transitions (grab, charge-complete, dock), not every frame, so this doesn't force a 60fps
+// re-render the way the original canvas's `forceUpdate()` did.
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { useSharedValue, type SharedValue } from "react-native-reanimated";
+import * as Haptics from "expo-haptics";
+import type { CardRarity } from "../../vaultReveal/config/types";
+
+export type CardOpenStatus = "sealed" | "open" | "pulled";
+
+interface RarityTuning {
+  /** Where this rarity's resonance value settles while held — a GRAIL card should feel like it's
+   * fighting back; a CORE card barely registers. Same ranges as the design's own TIER table. */
+  res: number;
+  /** How many rings/motes worth of flourish this rarity earns on open — consumed by
+   * HoldToOpenFanReveal, not used inside the physics loop itself. */
+  rings: number;
+  motes: number;
+  dim: number;
+  note: string;
+}
+
+const TUNING: Record<CardRarity, RarityTuning> = {
+  CORE: { res: 0.24, rings: 0, motes: 0, dim: 0, note: "Faint. Common weight." },
+  PRIME: { res: 0.66, rings: 1, motes: 8, dim: 0.42, note: "Something is answering." },
+  GRAIL: { res: 0.97, rings: 2, motes: 16, dim: 0.74, note: "It is loud under your thumb." },
+};
+
+const DEFAULT_HOLD_MS = 1500;
+
+export interface HoldToOpenDeck {
+  status: CardOpenStatus[];
+  /** Index currently mid-charge (finger down, not yet complete), or null. */
+  heldIndex: number | null;
+  /** Index sitting open/flipped, waiting to be tapped closed into the tray, or null. */
+  openIndex: number | null;
+  /** True only for the single card a press is currently allowed to grab (top of the sealed
+   * stack) — every other sealed card is inert until this one is dealt with. */
+  isGrabbable: (i: number) => boolean;
+  chargeSV: SharedValue<number>;
+  liftSV: SharedValue<number>;
+  jitterSV: SharedValue<number>;
+  resSV: SharedValue<number>;
+  /** Rarity flavor for whichever card is currently held or open — for the resonance/tell copy
+   * and ring/mote counts. Null when nothing is in flight. */
+  activeTuning: RarityTuning | null;
+  revealedCount: number;
+  total: number;
+  done: boolean;
+  grab: (i: number) => void;
+  release: () => void;
+  dock: () => void;
+  /** Escape hatch for an impatient user — same spirit as the old "tap to reveal faster" link the
+   * timer-based reveal had. Instantly settles every remaining card into the tray. */
+  revealAll: () => void;
+}
+
+export function useHoldToOpenDeck(rarities: CardRarity[], holdMs: number = DEFAULT_HOLD_MS): HoldToOpenDeck {
+  const total = rarities.length;
+  const [status, setStatus] = useState<CardOpenStatus[]>(() => rarities.map(() => "sealed"));
+  const [heldIndex, setHeldIndex] = useState<number | null>(null);
+  const [openIndex, setOpenIndex] = useState<number | null>(null);
+
+  const chargeSV = useSharedValue(0);
+  const liftSV = useSharedValue(0);
+  const jitterSV = useSharedValue(0);
+  const resSV = useSharedValue(0);
+
