+
+      <View style={styles.header}>
+        <Text style={styles.kicker}>{palette.kicker}</Text>
+        <Text style={styles.title}>Your Pull</Text>
+        <Text style={styles.counter}>{hold.revealedCount} / {total} REVEALED</Text>
+      </View>
+
+      <View style={styles.fanArea}>
+        {deck.map((_, i) => (
+          <FanCard
+            key={i}
+            face={faces[i]}
+            verso={verso}
+            photoUrl={items[i].textureUrl}
+            slot={slots[i]}
+            cardW={cardW}
+            cardH={cardH}
+            revealed={hold.status[i] !== "sealed"}
+            isFront={frontIndex === i}
+            dimmed={frontIndex !== null && frontIndex !== i}
+            zIndex={frontIndex === i ? total + 2 : i}
+            dealIndex={i}
+            chargeSV={hold.chargeSV}
