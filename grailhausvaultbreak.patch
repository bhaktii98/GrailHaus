+    size: 8.5, bold: true, mono: true, letterSpacing: 3.5, fill: rar.glow > 0.5 ? '#1a0f2e' : '#f0ece4',
+  });
+
+  drawTrackedText(canvas, card.name, CW / 2, ry + 48, {
