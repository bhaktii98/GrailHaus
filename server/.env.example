# Supabase project: grailhaus (ap-south-1)
# Get the DB password from the Supabase dashboard: Project Settings > Database
# > Database password (it is never returned by the API, so it's not filled in here).
#
# Using the Session Pooler host, not the direct db.<ref>.supabase.co host:
# the direct host only publishes an AAAA (IPv6) record, which this machine's
# network couldn't route to (ENOTFOUND on connect). The pooler resolves to a
# normal IPv4 address and works everywhere.
DATABASE_URL=postgresql://postgres.lspbbdcqwhzebnwcffen:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://lspbbdcqwhzebnwcffen.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxzcGJiZGNxd2h6ZWJud2NmZmVuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0NTI3OTAsImV4cCI6MjEwNDAyODc5MH0.ZeGb91WpdT8HjtbAojDch7pSXxsqLpLSmbmRIJ2Z5RA

PORT=3000

# Signs/verifies the mobile app's own email+password session tokens (see
# modules/auth) — unrelated to Supabase, which only the admin dashboard's
# separate magic-link login still uses. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_JWT_SECRET=<random-hex-string>

# Delivery transport for Supabase Auth's OTP emails, used only by the admin
# dashboard's magic-link login (configured as custom SMTP in the Supabase
# dashboard, not consumed by this server directly). The mobile app's own
# auth (above) sends no email at all.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=you@yourdomain.com
