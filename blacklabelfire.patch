+      else { x = (Math.random() < 0.5 ? -1 : 1) * hx * (1.0 + Math.random() * 0.1); y = (Math.random() * 2 - 1) * hy * 1.02; }
+      return [x, y, (Math.random() - 0.42) * 0.036];
+    }
